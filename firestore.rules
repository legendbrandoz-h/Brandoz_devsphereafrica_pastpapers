rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User accounts collection: users can read and update their profiles
    match /devsphere_users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin team & moderators collection
    match /devsphere_team_members/{memberId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Login and access audit logs
    match /devsphere_login_audit/{auditId} {
      allow read: if true;
      allow create: if true;
    }
    
    // Exam papers store
    match /devsphere_papers/{paperId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Fallback rule for all other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
